# 必須: Claude API キー（レポート分析に使用）
ANTHROPIC_API_KEY=

# 公開URL（マジックリンクやStripeの戻り先に使用）
APP_URL=http://localhost:3000

# Stripe（未設定なら開発モード: 決済なしでクレジット付与）
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# SMTP（未設定ならメール内容をサーバーのコンソールに出力）
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="BooScout <no-reply@example.com>"

# サポート問い合わせの転送先
SUPPORT_EMAIL=

# SQLite（省略時 ./data/booscout.db / 本番例: /data/booscout.db）
# DATABASE_PATH=
