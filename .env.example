# 必須: Claude API キー（レポート分析に使用）
ANTHROPIC_API_KEY=

# 公開URL（マジックリンクやStripeの戻り先に使用）
APP_URL=http://localhost:3000

# Stripe（未設定なら開発モード: 決済なしでクレジット付与）
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Resend（本番推奨。未設定なら SMTP → どちらも未設定ならコンソールに出力）
RESEND_API_KEY=
# 認証済みドメインのアドレス（Resend テスト時は BooScout <onboarding@resend.dev> も可）
EMAIL_FROM="BooScout <onboarding@resend.dev>"

# サポート問い合わせの転送先
SUPPORT_EMAIL=

# SQLite（省略時 ./data/booscout.db / 本番例: /data/booscout.db）
# DATABASE_PATH=
